# Kimi（月之暗面）API 密钥，在 https://platform.moonshot.cn/ 申请
MOONSHOT_API_KEY=在这里填入你的密钥

# 可选：API 接口地址，默认 https://api.moonshot.cn/v1（开放平台密钥无需修改）
# 如果你用的是 Kimi Code 版（sk-kim... 开头）的密钥，改成下面这个：
# MOONSHOT_BASE_URL=https://api.kimi.com/coding/v1

# 可选：使用的模型，默认 moonshot-v1-8k
MOONSHOT_MODEL=moonshot-v1-8k

# 可选：每天生成日报的时间（24 小时制），默认 08:00
REPORT_TIME=08:00
